<widget class="QWidget" name="abaSaidas">
<attribute name="title"><string>Saídas</string></attribute>
<layout class="QVBoxLayout" name="layoutv_abaSaidas">
<item>
<widget class="QGroupBox" name="grupoSaida">
<property name="title"><string>Onde gravar</string></property>
<layout class="QVBoxLayout" name="layoutv_grupoSaida">
<item>
<widget class="QLabel" name="nota_grupoSaida">
<property name="text"><string>Sempre gerado: &lt;prefixo&gt;_K.tif — a proporção máxima esperada, entrada do modelo dinâmico. Com sub-bacias informadas, sai também &lt;prefixo&gt;_subbacias.gpkg com o potencial remanescente, o grau de explotação e o ranking.</string></property>
