<property name="wordWrap"><bool>true</bool></property>
<property name="toolTip"><string>No produto ponderado, 0^w = 0 para qualquer peso: uma única variável zerada anula o pixel. O piso preserva a ordem e impede que a variável mais fraca decida sozinha onde não pode haver garimpo.</string></property>
</widget>
</item>
